# Copia este archivo como .env.test para ejecutar las pruebas de integración (npm test).
# Debe apuntar a una base de datos EXCLUSIVA de pruebas: su nombre tiene que terminar en _test,
# porque las pruebas borran y recrean datos. Las migraciones se aplican solas (prisma migrate deploy).
DATABASE_URL_TEST=postgresql://USUARIO:CLAVE@localhost:5432/creafacil_test?schema=public
