{
  "info": {
    "_postman_id": "6f1c2a8e-5b3d-4c7a-9e21-0c4f6d8b1a01",
    "name": "CreaFácil API",
    "description": "Colección de pruebas de la API REST de CreaFácil (DERCAS §6: «los endpoints responden correctamente en las pruebas con Postman, incluyendo validaciones, autenticación y errores»; RNF-02, RNF-07).\n\nVariable principal: `baseUrl` (por ejemplo `http://localhost:3000/api/v1`). Selecciona el entorno «CreaFácil · local» antes de ejecutarla.\n\nCada petición tiene pruebas (pestaña Tests/Scripts) que comprueban el código HTTP, el Content-Type JSON y la forma del cuerpo. Las comprobaciones comunes (JSON y cabeceras de seguridad) están a nivel de colección.\n\nRequisitos previos: servidor en marcha (`npm run dev`) con PostgreSQL disponible, para que /health responda 200.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Comprobaciones comunes a todas las respuestas de la API (RNF-02).",
          "pm.test('[común] responde en JSON (Content-Type application/json)', function () {",
          "    pm.response.to.have.header('Content-Type');",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/json/);",
          "});",
          "",
          "pm.test('[común] aplica cabeceras de seguridad y oculta X-Powered-By', function () {",
          "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
          "    pm.expect(pm.response.headers.has('X-Powered-By')).to.be.false;",
          "});",
          "",
          "// Forma común de los errores: { error: { codigo, mensaje, detalles? } }.",
          "if (pm.response.code >= 400 && pm.response.code !== 503) {",
          "    pm.test('[común] el error tiene la forma { error: { codigo, mensaje } }', function () {",
          "        const cuerpo = pm.response.json();",
          "        pm.expect(cuerpo).to.have.property('error').that.is.an('object');",
          "        pm.expect(cuerpo.error.codigo).to.be.a('string').and.match(/^[A-Z_]+$/);",
          "        pm.expect(cuerpo.error.mensaje).to.be.a('string').and.not.be.empty;",
          "        pm.expect(JSON.stringify(cuerpo)).to.not.match(/stack|at .*\\.(js|ts):/);",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Salud",
      "description": "Estado de la API y de la conexión con PostgreSQL (RNF-07, RNF-08).",
      "item": [
        {
          "name": "Información de la API",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('devuelve el nombre y la versión de la API', function () {",
                  "    const cuerpo = pm.response.json();",
                  "    pm.expect(cuerpo.nombre).to.eql('CreaFácil API');",
                  "    pm.expect(cuerpo.version).to.match(/^\\d+\\.\\d+\\.\\d+$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            },
            "description": "GET /api/v1 — nombre y versión de la API."
          },
          "response": []
        },
        {
          "name": "Estado del servicio (health)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = pm.response.json();",
                  "",
                  "pm.test('responde 200 (la base de datos está disponible)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('estado ok y baseDatos ok', function () {",
                  "    pm.expect(cuerpo.estado).to.eql('ok');",
                  "    pm.expect(cuerpo.baseDatos).to.eql('ok');",
                  "});",
                  "",
                  "pm.test('incluye servicio, versión, entorno, marca de tiempo ISO y tiempo de actividad', function () {",
                  "    pm.expect(cuerpo.servicio).to.eql('CreaFácil API');",
                  "    pm.expect(cuerpo.version).to.be.a('string');",
                  "    pm.expect(cuerpo.entorno).to.be.oneOf(['development', 'test', 'production']);",
                  "    pm.expect(new Date(cuerpo.marcaTiempo).toISOString()).to.eql(cuerpo.marcaTiempo);",
                  "    pm.expect(cuerpo.tiempoActividadSegundos).to.be.a('number').and.at.least(0);",
                  "});",
                  "",
                  "pm.test('no expone detalles internos de la conexión', function () {",
                  "    pm.expect(pm.response.text()).to.not.match(/postgresql:\\/\\/|password|ECONNREFUSED/i);",
                  "});",
                  "",
                  "pm.test('responde en menos de 3 s', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "GET /api/v1/health — 200 con `estado: ok` y `baseDatos: ok`. Si PostgreSQL no responde, la API devuelve 503 con `estado: degradado` y `baseDatos: error` (ese caso se cubre en las pruebas automáticas con Vitest)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Errores",
      "description": "Contrato de errores de la API: siempre JSON con `{ error: { codigo, mensaje, detalles? } }` y el código HTTP correcto (RNF-02). Los 401/403 se añadirán con las rutas de la Fase 1 (RF-01, RF-02).",
      "item": [
        {
          "name": "Ruta inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('error.codigo es RUTA_NO_ENCONTRADA e indica método y ruta', function () {",
                  "    const cuerpo = pm.response.json();",
                  "    pm.expect(cuerpo.error.codigo).to.eql('RUTA_NO_ENCONTRADA');",
                  "    pm.expect(cuerpo.error.mensaje).to.eql('No existe la ruta GET /api/v1/no-existe');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/no-existe",
              "host": ["{{baseUrl}}"],
              "path": ["no-existe"]
            },
            "description": "GET /api/v1/no-existe — 404 RUTA_NO_ENCONTRADA."
          },
          "response": []
        },
        {
          "name": "JSON mal formado (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('error.codigo es JSON_INVALIDO', function () {",
                  "    const cuerpo = pm.response.json();",
                  "    pm.expect(cuerpo.error.codigo).to.eql('JSON_INVALIDO');",
                  "    pm.expect(cuerpo.error.mensaje).to.eql('El cuerpo de la petición no es un JSON válido.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\": \"Mural\", \"cantidad\": ",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "POST /api/v1/health con un JSON incompleto — 400 JSON_INVALIDO (el cuerpo se lee antes de buscar la ruta)."
          },
          "response": []
        },
        {
          "name": "Cuerpo demasiado grande (413)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// El límite de la API es 1 MB: se genera un texto algo mayor.",
                  "pm.variables.set('cuerpoGrande', 'x'.repeat(1024 * 1024 + 1024));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 413', function () {",
                  "    pm.response.to.have.status(413);",
                  "});",
                  "",
                  "pm.test('error.codigo es CUERPO_DEMASIADO_GRANDE', function () {",
                  "    const cuerpo = pm.response.json();",
                  "    pm.expect(cuerpo.error.codigo).to.eql('CUERPO_DEMASIADO_GRANDE');",
                  "    pm.expect(cuerpo.error.mensaje).to.eql('El cuerpo de la petición supera el tamaño permitido.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"relleno\": \"{{cuerpoGrande}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "POST /api/v1/health con un JSON de más de 1 MB (generado en el pre-request script) — 413 CUERPO_DEMASIADO_GRANDE."
          },
          "response": []
        },
        {
          "name": "Charset no soportado (415)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 415', function () {",
                  "    pm.response.to.have.status(415);",
                  "});",
                  "",
                  "pm.test('error.codigo es SOLICITUD_INVALIDA', function () {",
                  "    pm.expect(pm.response.json().error.codigo).to.eql('SOLICITUD_INVALIDA');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json; charset=latin1" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"a\": 1}"
            },
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "POST /api/v1/health con un charset distinto de UTF-8 — 415 SOLICITUD_INVALIDA."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    }
  ]
}
