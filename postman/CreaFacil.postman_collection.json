          "name": "Inicio de sesión de la administradora (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('adminPassword')) {",
                  "    console.warn('Falta adminPassword en el entorno: escribe la contraseña de ADMIN_PASSWORD de tu .env en el valor actual (Current value) del entorno, o usa npm run test:postman.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200 (si falla, revisa adminEmail/adminPassword en el entorno)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const cuerpo = pm.response.json();",
                  "",
                  "pm.test('devuelve { token, tipo: \"Bearer\", expiraEn, usuario }', function () {",
                  "    pm.expect(Object.keys(cuerpo).sort()).to.eql(['expiraEn', 'tipo', 'token', 'usuario']);",
                  "    pm.expect(cuerpo.tipo).to.eql('Bearer');",
                  "    pm.expect(cuerpo.token.split('.')).to.have.lengthOf(3);",
                  "});",
                  "",
                  "pm.test('el token expira en unas 8 horas (sin refresh token)', function () {",
                  "    const horas = (new Date(cuerpo.expiraEn).getTime() - Date.now()) / 3600000;",
                  "    pm.expect(horas).to.be.within(7.9, 8.01);",
                  "});",
                  "",
                  "pm.test('usuario con id UUID (texto) y rol ADMIN', function () {",
                  "    pm.expect(Object.keys(cuerpo.usuario).sort()).to.eql(['email', 'id', 'nombre', 'rol', 'telefono']);",
                  "    pm.expect(cuerpo.usuario.id).to.be.a('string').and.match(/^[0-9a-f-]{36}$/);",
                  "    pm.expect(cuerpo.usuario.rol).to.eql('ADMIN');",
                  "});",
                  "",
                  "pm.test('nunca devuelve la contraseña ni su hash (RNF-01)', function () {",
                  "    pm.expect(pm.response.text()).to.not.match(/passwordHash|password|\\$2[aby]\\$/);",
                  "});",
                  "",
                  "pm.test('es la cuenta de adminEmail', function () {",
                  "    pm.expect(cuerpo.usuario.email).to.eql(String(pm.environment.get('adminEmail')).trim().toLowerCase());",
                  "});",
                  "",
                  "pm.collectionVariables.set('tokenAdmin', cuerpo.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "POST /api/v1/auth/login con las credenciales del seed (variables de entorno `adminEmail` y `adminPassword`) — 200 con `usuario.rol = \"ADMIN\"`. El token se guarda en `tokenAdmin` (se usará en la subfase 1.2)."
          },
          "response": []
        }
