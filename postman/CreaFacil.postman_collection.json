                  "    const cuerpo = pm.response.json();",
                  "    pm.expect(cuerpo.nombre).to.eql('CreaFácil API');",
                  "    pm.expect(cuerpo.version).to.match(/^\\d+\\.\\d+\\.\\d+$/);",
