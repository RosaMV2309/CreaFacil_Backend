        {
          "name": "Estado del servicio (health)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = pm.response.json();",
                  "",
                  "pm.test('responde 200 (la base de datos está disponible)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('estado ok y baseDatos ok', function () {",
                  "    pm.expect(cuerpo.estado).to.eql('ok');",
                  "    pm.expect(cuerpo.baseDatos).to.eql('ok');",
                  "});",
                  "",
                  "pm.test('incluye servicio, versión, entorno, marca de tiempo ISO y tiempo de actividad', function () {",
                  "    pm.expect(cuerpo.servicio).to.eql('CreaFácil API');",
                  "    pm.expect(cuerpo.version).to.be.a('string');",
                  "    pm.expect(cuerpo.entorno).to.be.oneOf(['development', 'test', 'production']);",
                  "    pm.expect(new Date(cuerpo.marcaTiempo).toISOString()).to.eql(cuerpo.marcaTiempo);",
                  "    pm.expect(cuerpo.tiempoActividadSegundos).to.be.a('number').and.at.least(0);",
                  "});",
                  "",
                  "pm.test('no expone detalles internos de la conexión', function () {",
                  "    pm.expect(pm.response.text()).to.not.match(/postgresql:\\/\\/|password|ECONNREFUSED/i);",
                  "});",
                  "",
                  "pm.test('responde en menos de 3 s', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
