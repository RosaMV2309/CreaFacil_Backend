        {
          "name": "Perfil con token alterado (401)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Cambia el rol del token a ADMIN sin volver a firmarlo: la firma deja de coincidir.",
                  "const partes = (pm.collectionVariables.get('tokenCliente') || 'a.b.c').split('.');",
                  "const datos = JSON.parse(CryptoJS.enc.Base64.parse(partes[1].replace(/-/g, '+').replace(/_/g, '/')).toString(CryptoJS.enc.Utf8));",
                  "datos.rol = 'ADMIN';",
                  "const alterado = CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(JSON.stringify(datos)))",
                  "    .replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "pm.variables.set('tokenAlterado', [partes[0], alterado, partes[2]].join('.'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('error.codigo es TOKEN_INVALIDO', function () {",
                  "    const cuerpo = pm.response.json();",
                  "    pm.expect(cuerpo.error.codigo).to.eql('TOKEN_INVALIDO');",
                  "    pm.expect(cuerpo.error.mensaje).to.eql('El token de sesión no es válido. Inicia sesión de nuevo.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
