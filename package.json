{
  "name": "creafacil-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor y API REST de CreaFácil: gestión de pedidos, cotizaciones y planificación de trabajos personalizados.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unitarias",
    "test:integracion": "vitest run --project integracion",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RosaMV2309/CreaFacil_Backend.git"
  },
  "author": "Rosa Virginia Moreira Vidal",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
