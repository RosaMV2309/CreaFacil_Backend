# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio.
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/creafacil?schema=public

# JWT: usa una cadena aleatoria de al menos 32 caracteres
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-de-32-caracteres
# Duración del token de sesión: número + unidad (s, m, h, d). Sin refresh token.
JWT_EXPIRES_IN=8h

# Límite de intentos FALLIDOS de inicio de sesión por IP (los correctos no cuentan).
# Al superarlo, POST /auth/login responde 429 hasta que termine la ventana.
# Si ejecutas newman muchas veces seguidas en local, sube LOGIN_MAX_INTENTOS (p. ej. 50)
# o reinicia el servidor (los contadores están en memoria).
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15

# Orígenes permitidos, separados por comas (app web y panel administrativo)
CORS_ORIGIN=http://localhost:5000,http://localhost:5001

# Cuenta inicial de la administradora: SOLO la usa el seed (npm run db:seed).
# La contraseña debe tener entre 8 y 72 caracteres; se guarda como hash bcrypt, nunca en texto.
ADMIN_EMAIL=admin@creafacil.local
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_NOMBRE=Administradora CreaFácil
